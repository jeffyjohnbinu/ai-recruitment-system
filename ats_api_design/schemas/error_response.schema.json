{
  "type": "object",
  "description": "RFC 7807 problem+json, extended with a stable machine-readable `code` and `trace_id`.",
  "required": [
    "type",
    "title",
    "status",
    "code",
    "trace_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri",
      "example": "https://api.zecpath.example.com/errors/validation-error"
    },
    "title": {
      "type": "string",
      "example": "Validation failed"
    },
    "status": {
      "type": "integer",
      "example": 400
    },
    "detail": {
      "type": "string",
      "example": "field 'file' is required"
    },
    "instance": {
      "type": "string",
      "format": "uri"
    },
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "trace_id": {
      "type": "string",
      "description": "Correlates to the X-Request-ID propagated through logs"
    },
    "errors": {
      "type": "array",
      "description": "Optional per-field validation details",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "UNSUPPORTED_FILE_TYPE",
        "PAYLOAD_TOO_LARGE",
        "RESOURCE_NOT_FOUND",
        "PARSING_FAILED",
        "DEPENDENCY_UNAVAILABLE",
        "RATE_LIMITED",
        "IDEMPOTENCY_KEY_REUSED",
        "INTERNAL_ERROR"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse"
}