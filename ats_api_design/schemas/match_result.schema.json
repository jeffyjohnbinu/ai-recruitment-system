{
  "type": "object",
  "required": [
    "match_id",
    "resume_id",
    "job_description_id",
    "overall_score"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "format": "uuid"
    },
    "resume_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_description_id": {
      "type": "string",
      "format": "uuid"
    },
    "overall_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScoreComponent"
      }
    },
    "weakest_component": {
      "type": "string",
      "description": "Name of the component with the lowest raw_score (Day 13 fix: ranked by raw score, not weighted contribution).\n"
    },
    "narrative_explanation": {
      "type": "string",
      "description": "Human-readable explainability narrative"
    },
    "missing_data_mode": {
      "$ref": "#/$defs/MissingDataMode"
    },
    "metadata": {
      "$ref": "#/$defs/MetadataEnvelope"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "ScoreComponent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "skills"
        },
        "raw_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weighted_contribution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "MissingDataMode": {
      "type": "string",
      "enum": [
        "strict",
        "lenient",
        "impute_median"
      ],
      "description": "Mirrors the three missing-data modes from the Day 13 ATS Scoring Engine."
    },
    "MetadataEnvelope": {
      "type": "object",
      "description": "Day 7 metadata envelope standard, applied to every stored record.",
      "properties": {
        "schema_version": {
          "type": "string",
          "example": "1.3.0"
        },
        "model_version": {
          "type": "string",
          "example": "semantic-matcher-2.1"
        },
        "pipeline_version": {
          "type": "string",
          "example": "2026.08.15"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchResult"
}