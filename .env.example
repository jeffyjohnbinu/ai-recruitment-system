# Copy this file to .env and fill in real values. Never commit .env itself.

# --- AI Provider ---
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# --- App Config ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs

# --- ATS Engine ---
ATS_MIN_MATCH_SCORE=0.65      # minimum score (0-1) for auto-shortlisting

# --- Database (optional, future use) ---
DATABASE_URL=sqlite:///./data/processed/recruitment.db
